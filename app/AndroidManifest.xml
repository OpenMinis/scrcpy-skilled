<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="app.openminis.vdisplay">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="33"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <application android:label="@string/app_name" android:usesCleartextTraffic="true">
    <service android:name=".PipService" android:exported="true"/>
    <service android:name=".UiService" android:exported="true" android:label="@string/a11y_label"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/ui_service"/>
    </service>
  </application>
</manifest>
